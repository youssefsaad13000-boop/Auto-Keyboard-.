{
  "schemaVersion": 1,
  "id": "auto_keyboard",
  "version": "${version}",
  "name": "Auto Android Keyboard",
  "description": "Automatically opens the Android keyboard when typing in Minecraft.",
  "authors": [
    "Youssef"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.ExampleModClient"
    ]
  },
  "mixins": [
    "auto_keyboard.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "1.21.11",
    "fabric-api": "*"
  }
}
